# Sentry Error Tracking
# Get your DSN from https://sentry.io/settings/projects/
# Proxy-Server: For backend error tracking
SENTRY_DSN=https://your-dsn@sentry.io/project-id
# Desktop App: For frontend error tracking (must be NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Stripe Integration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# License Validation
JWT_SECRET=your-jwt-secret-here

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# Database (PostgreSQL for multi-tenant server)
DATABASE_URL=postgresql://user:password@localhost:5432/voiceinvoice

# Environment
NODE_ENV=production
