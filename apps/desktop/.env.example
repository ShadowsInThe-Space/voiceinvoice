# Database configuration for VoiceInvoice Desktop
DATABASE_URL="file:./data/voiceinvoice.db"

# Proxy-Server API (Lizenz, Sync, Stripe)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Google AI API Key (required for voice transcription and RAG chat)
NEXT_PUBLIC_GOOGLE_API_KEY=""
GEMINI_API_KEY=""

# Google Cloud / Chirp 3 (Speech-to-Text)
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="eu"
CHIRP3_RECOGNIZER="invoice-chirp3-de"
NEXT_PUBLIC_GOOGLE_CLOUD_PROJECT=""
NEXT_PUBLIC_GOOGLE_CLOUD_LOCATION="eu"
NEXT_PUBLIC_CHIRP3_RECOGNIZER="invoice-chirp3-de"

# Optional: Demo API Key (nur für Demo-Mode)
NEXT_PUBLIC_DEMO_API_KEY=""

# Supabase Configuration (for E2E encrypted sync and RAG)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
SUPABASE_KEY="your-legacy-key-here"

# n8n Webhook URLs
NEXT_PUBLIC_N8N_CHAT_WEBHOOK=""
NEXT_PUBLIC_N8N_INGEST_WEBHOOK=""
NEXT_PUBLIC_N8N_WEBHOOK_URL="http://localhost:5678/webhook"
N8N_CHAT_WEBHOOK=""
N8N_INGEST_WEBHOOK=""
N8N_WEBHOOK_RECHNUNGSEINGANG=""
N8N_WEBHOOK_MAHNWESEN=""

# Voice Agent Provider Keys
GOOGLE_AI_API_KEY=""
OPENAI_API_KEY=""
ELEVENLABS_API_KEY=""

# Electron Dev Server (optional)
ELECTRON_DEV_URL="http://localhost:3002"
