# Database configuration for VoiceInvoice Desktop
DATABASE_URL="file:./data/voiceinvoice.db"

# Google AI API Key (required for voice transcription and RAG chat)
NEXT_PUBLIC_GOOGLE_API_KEY=""

# Supabase Configuration (for E2E encrypted sync and RAG)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# n8n Webhook URLs for RAG Chat
NEXT_PUBLIC_N8N_CHAT_WEBHOOK=""
NEXT_PUBLIC_N8N_INGEST_WEBHOOK=""
