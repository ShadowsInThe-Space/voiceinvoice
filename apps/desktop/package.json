{
  "name": "@voiceinvoice/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "VoiceInvoice Desktop Application (Electron + Next.js)",
  "author": "VoiceInvoice Team <team@voiceinvoice.com>",
  "homepage": "https://voiceinvoice.com",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "next dev -p 3002",
    "dev:electron": "node scripts/build-electron.mjs && concurrently \"npm run dev\" \"wait-on http://localhost:3002 && NODE_ENV=development ELECTRON_DEV_URL=http://localhost:3002 electron . --no-sandbox\"",
    "build": "next build",
    "build:electron": "node scripts/build-electron.mjs && prisma db push --skip-generate && tsx prisma/seed.ts && next build && node scripts/prepare-standalone.mjs && electron-builder",
    "start": "next start",
    "lint": "next lint && eslint electron --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:quick": "electron-builder --dir --config.compression=store",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google-cloud/speech": "^7.2.1",
    "@google-cloud/text-to-speech": "^6.4.0",
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.9.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.1.7",
    "form-data": "^4.0.5",
    "formidable": "^3.5.4",
    "jspdf": "^4.1.0",
    "lucide-react": "^0.563.0",
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/formidable": "^3.4.6",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@voiceinvoice/ai-orchestrator": "workspace:*",
    "@voiceinvoice/database": "workspace:*",
    "@voiceinvoice/encryption-layer": "workspace:*",
    "@voiceinvoice/privacy-engine": "workspace:*",
    "@voiceinvoice/shared-types": "workspace:*",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "electron": "^35.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": ">=0.25.0",
    "eslint-config-next": "^14.1.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.0",
    "prisma": "^5.9.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.voiceinvoice.enterprise",
    "productName": "VoiceInvoice Enterprise",
    "executableName": "voiceinvoice-enterprise",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Shadows-In-The-Space",
        "repo": "invoice_finance_app"
      }
    ],
    "files": [
      "dist/electron/**/*",
      ".next/standalone/**/*",
      "src/generated/**/*",
      "prisma/data/**/*",
      "!**/.turbo/**",
      "!**/coverage/**"
    ],
    "asar": false,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "executableName": "voiceinvoice-enterprise"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
