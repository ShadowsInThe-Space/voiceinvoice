{
  "name": "@voiceinvoice/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "VoiceInvoice Desktop Application (Electron + Next.js)",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "dev:electron": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "next build",
    "build:electron": "next build && electron-builder",
    "start": "next start",
    "lint": "next lint && eslint electron --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:quick": "electron-builder --dir --config.compression=store"
  },
  "dependencies": {
    "@prisma/client": "^5.9.0",
    "@voiceinvoice/ai-orchestrator": "workspace:*",
    "@voiceinvoice/database": "workspace:*",
    "@voiceinvoice/privacy-engine": "workspace:*",
    "@voiceinvoice/shared-types": "workspace:*",
    "jspdf": "^4.0.0",
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.0",
    "eslint-config-next": "^14.1.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.0",
    "prisma": "^5.9.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.voiceinvoice.enterprise",
    "productName": "VoiceInvoice Enterprise",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
