# Proxy Server Environment Variables

# Google Cloud API Key (for Speech-to-Text and Gemini)
GOOGLE_API_KEY=your-google-api-key-here

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# Rate limiting (requests per minute)
RATE_LIMIT=60

# Logging
ENABLE_LOGGING=true

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/voiceinvoice_proxy

# Supabase Configuration (for E2E encrypted sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# Email delivery (transactional)
EMAIL_WEBHOOK_URL=https://your-webhook-url-here
EMAIL_FROM="VoiceInvoice <no-reply@voiceinvoice.de>"
SUPPORT_EMAIL=support@voiceinvoice.de
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_BASE_DELAY_MS=200