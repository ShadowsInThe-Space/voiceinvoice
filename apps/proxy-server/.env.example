# Proxy Server Environment Variables

# Google Cloud API Key (for Speech-to-Text and Gemini)
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=eu
CHIRP3_RECOGNIZER=invoice-chirp3-de
GEMINI_API_KEY=your-gemini-api-key-here

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
NODE_TLS_REJECT_UNAUTHORIZED=1

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# Rate limiting (requests per minute)
RATE_LIMIT=60

# Logging
ENABLE_LOGGING=true

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/voiceinvoice_proxy

# Supabase Configuration (for E2E encrypted sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_KEY=your-legacy-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe (License & Billing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# JWT (License Auth)
JWT_SECRET=your-strong-secret
