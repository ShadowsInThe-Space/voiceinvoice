{
  "name": "@voiceinvoice/proxy-server",
  "version": "0.1.0",
  "private": true,
  "description": "VoiceInvoice Proxy Server (Fastify + Vertex AI)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate --schema=prisma/schema-server.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema-server.prisma"
  },
  "dependencies": {
    "@voiceinvoice/shared-types": "workspace:*",
    "@google-cloud/aiplatform": "^3.10.0",
    "@prisma/client": "^5.9.0",
    "fastify": "^5.0.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.1.0",
    "@fastify/rate-limit": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prisma": "^5.9.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
