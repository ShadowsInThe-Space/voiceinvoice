// Server-side PostgreSQL schema for VoiceInvoice Proxy
// Multi-tenant with license tracking

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// License for API access tracking.
/// Each desktop installation has one license.
model License {
  id              String   @id @default(uuid())

  /// License key (unique identifier)
  licenseKey      String   @unique

  /// Company name for the license holder
  companyName     String

  /// License status
  status          String   @default("ACTIVE")

  /// Monthly API call quota
  monthlyQuota    Int      @default(1000)

  /// Current month usage count
  currentUsage    Int      @default(0)

  /// When the usage counter resets
  usageResetDate  DateTime

  /// License expiration date
  expiresAt       DateTime

  /// Stripe customer ID for billing portal access
  stripeCustomerId String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// Entities synced by this license
  syncedEntities  SyncedEntity[]

  @@index([licenseKey])
  @@index([status])
}

/// Generic storage for synced entities.
/// Stores JSON data blobs for offline synchronization.
model SyncedEntity {
  id          String   @id @default(uuid())

  /// Type of entity (e.g., 'customer', 'invoice')
  entityType  String

  /// ID of the entity on the client side
  entityId    String

  /// The actual entity data in JSON format
  data        Json

  /// When the entity was last updated on the server
  updatedAt   DateTime @updatedAt

  /// Whether the entity has been deleted
  deleted     Boolean  @default(false)

  /// Foreign key to License
  licenseId   String
  license     License  @relation(fields: [licenseId], references: [id])

  /// Ensure uniqueness per entity per license
  @@unique([licenseId, entityType, entityId])

  /// Index for efficient sync queries (pulling changes since timestamp)
  @@index([licenseId, updatedAt])
}
