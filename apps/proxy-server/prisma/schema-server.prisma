// Server-side PostgreSQL schema for VoiceInvoice Proxy
// Multi-tenant with license tracking

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// License for API access tracking.
/// Each desktop installation has one license.
model License {
  id              String   @id @default(uuid())

  /// License key (unique identifier)
  licenseKey      String   @unique

  /// Company name for the license holder
  companyName     String

  /// License status
  status          String   @default("ACTIVE")

  /// Monthly API call quota
  monthlyQuota    Int      @default(1000)

  /// Current month usage count
  currentUsage    Int      @default(0)

  /// When the usage counter resets
  usageResetDate  DateTime

  /// License expiration date
  expiresAt       DateTime

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// Synced entities for offline-first data
  syncedEntities  SyncedEntity[]

  @@index([licenseKey])
  @@index([status])
}

/// Generic storage for synced entities from desktop clients.
/// Provides a simple key-value store per tenant (license) partitioned by entity type.
model SyncedEntity {
  id              String   @id @default(uuid())

  /// Foreign Key to License (Tenant)
  licenseId       String
  license         License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  /// Type of entity (e.g., 'customer', 'invoice')
  entityType      String

  /// ID of the entity in the desktop app (client-generated UUID)
  entityId        String

  /// The actual data payload (JSON)
  data            Json

  /// Version number for conflict resolution (incremented on update)
  version         Int      @default(1)

  /// When this entity was last deleted (soft delete)
  deletedAt       DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// Composite unique constraint ensures one entity ID per type per tenant
  @@unique([licenseId, entityType, entityId])
  @@index([licenseId, entityType, updatedAt])
}
