{
  "name": "voiceinvoice-enterprise",
  "version": "0.1.0",
  "private": true,
  "description": "Voice-First Buchhaltungsanwendung mit AI-Powered Features",
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:electron": "pnpm --filter @voiceinvoice/desktop run dev:electron",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test --coverage",
    "ci:validate": "pnpm run ci:lint && pnpm run ci:typecheck && pnpm run ci:test && pnpm run ci:build",
    "ci:lint": "turbo run lint",
    "ci:typecheck": "turbo run typecheck",
    "ci:test": "turbo run test -- --coverage",
    "ci:docs": "pnpm run docs:generate && pnpm run docs:check",
    "ci:build": "turbo run build",
    "ci:build:electron": "cd apps/desktop && pnpm run package:quick",
    "docs:generate": "doxygen Doxyfile 2>&1 | tee docs/api/doxygen_warnings.log",
    "docs:check": "node tools/scripts/check-doxygen-warnings.js",
    "docs:serve": "npx http-server docs/api/html -p 8080",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^48.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0",
    "@vitest/coverage-istanbul": "^1.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
