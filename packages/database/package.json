{
  "name": "@voiceinvoice/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma database clients for VoiceInvoice (SQLite + PostgreSQL)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./generated/client/index.d.ts",
      "import": "./generated/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/server/index.ts --format cjs,esm && tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "tsup src/index.ts src/server/index.ts --format cjs,esm --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate --schema=prisma/schema-client.prisma",
    "db:generate:server": "prisma generate --schema=prisma/schema-server.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema-client.prisma",
    "db:migrate:server": "prisma migrate dev --schema=prisma/schema-server.prisma",
    "db:push": "prisma db push --schema=prisma/schema-client.prisma",
    "db:push:server": "prisma db push --schema=prisma/schema-server.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prisma": "^5.9.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.11"
  }
}
