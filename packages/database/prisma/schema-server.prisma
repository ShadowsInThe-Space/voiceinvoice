// Server-side PostgreSQL schema for VoiceInvoice Enterprise
// Multi-tenant schema with license tracking

generator client {
  provider = "prisma-client-js"
  output   = "../generated/server"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums based on shared-types

enum CustomerType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  CANCELLED
  OVERDUE
}

enum PrivacyMode {
  STRICT
  STANDARD
  MINIMAL
}

enum LicenseStatus {
  TRIAL
  ACTIVE
  EXPIRED
  INVALID
}

// Core Multi-Tenancy Models

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  license          License?
  appSettings      AppSettings?

  customers        Customer[]
  invoices         Invoice[]
  recordings       Recording[]
  categories       Category[]
  bankTransactions BankTransaction[]
  auditLogs        AuditLog[]
}

model User {
  id        String   @id @default(uuid())
  email     String
  /// Hashed password using bcrypt. Never store plaintext passwords.
  password  String
  name      String?

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

model License {
  id              String        @id @default(uuid())
  licenseKey      String        @unique
  status          LicenseStatus @default(ACTIVE)

  monthlyQuota    Int           @default(1000)
  currentUsage    Int           @default(0)
  usageResetDate  DateTime
  expiresAt       DateTime

  tenantId        String        @unique
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([licenseKey])
  @@index([status])
}

// Domain Models

model Customer {
  id              String       @id @default(uuid())
  type            CustomerType

  companyName     String
  contactPerson   String?
  email           String?
  phone           String?

  taxNumber       String?
  vatId           String?
  iban            String?
  bic             String?

  street          String?
  zip             String?
  city            String?
  country         String       @default("DE")

  anonymizedToken String?

  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  invoices        Invoice[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([tenantId, anonymizedToken])
  @@index([tenantId])
  @@index([companyName])
}

model Invoice {
  id                String        @id @default(uuid())
  invoiceNumber     String

  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)

  categoryId        String?
  category          Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  date              DateTime
  dueDate           DateTime?

  netAmount         Decimal       @db.Decimal(10, 2)
  taxRate           Int           // 0, 7, 19
  taxAmount         Decimal       @db.Decimal(10, 2)
  grossAmount       Decimal       @db.Decimal(10, 2)
  currency          String        @default("EUR")

  status            InvoiceStatus
  description       String?

  recordingId       String?
  recording         Recording?    @relation(fields: [recordingId], references: [id], onDelete: SetNull)

  transcription     String?       @db.Text
  enrichedData      Json?         // JSON string in types, but Json type in Postgres is better

  bankTransactionId String?       @unique
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id])

  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, status])
}

model Recording {
  id                   String   @id @default(uuid())
  audioPath            String
  audioFormat          String
  duration             Int      // milliseconds
  sampleRate           Int

  transcription        String?  @db.Text
  language             String

  enrichedData         Json?
  confidence           Float?

  anonymizedTranscript String?  @db.Text
  privacyTokenMap      Json?

  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  invoices             Invoice[]

  createdAt            DateTime @default(now())

  @@index([tenantId])
}

model Category {
  id        String     @id @default(uuid())
  name      String
  code      String?
  color     String?

  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryHierarchy")

  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  invoices  Invoice[]

  createdAt DateTime   @default(now())

  @@index([tenantId])
}

model BankTransaction {
  id               String   @id @default(uuid())
  importDate       DateTime
  sourceFile       String?

  transactionDate  DateTime
  valueDate        DateTime

  counterparty     String
  counterpartyIban String?

  amount           Decimal  @db.Decimal(10, 2)
  currency         String
  purpose          String?

  // matchedInvoiceId in types is handled by One-to-One relation in Invoice
  invoice          Invoice?

  matchConfidence  Float?
  reconciled       Boolean  @default(false)

  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt        DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, reconciled])
}

model AppSettings {
  id                String        @id @default(uuid())

  n8nWebhookUrl     String?
  n8nEnabled        Boolean       @default(false)

  bankFolderPath    String?
  bankSyncEnabled   Boolean       @default(false)

  privacyMode       PrivacyMode   @default(STANDARD)

  tenantId          String        @unique
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  updatedAt         DateTime      @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  details    Json?
  agentName  String?

  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
}
