{
  "name": "@voiceinvoice/privacy-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Dual-layer privacy engine for VoiceInvoice (anonymization, tokenization)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@voiceinvoice/shared-types": "workspace:*",
    "fuse.js": "^7.1.0"
  },
  "peerDependencies": {
    "@google-cloud/speech": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@google-cloud/speech": {
      "optional": true
    }
  },
  "devDependencies": {
    "@google-cloud/speech": "^6.0.0",
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.11"
  }
}
